NODE_ENV=development
PORT=5001

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=merchant_platform

REDIS_HOST=localhost
REDIS_PORT=6379

# Auth: use a long random secret (e.g. `openssl rand -base64 48`) outside local dev
JWT_SECRET=jwtsecretPassword
JWT_EXPIRES_IN=3600

# Seed users (npm run seed). Local development only.
SEED_PASSWORD=Admin@123

# Field-level encryption (AES-256-GCM) for sensitive columns such as ownerTaxId.
# 32 random bytes, base64. Generate your own: openssl rand -base64 32
# The value below is a PUBLISHED LOCAL-DEV key; the app refuses it when NODE_ENV=production.
FIELD_ENCRYPTION_KEY=n9bRxLzfgSEjnnd06ZE3cdEFuPzeLuK4/6bkMaFfwmg=

# HTTP request logging. Bodies are off by default; when on they are redacted.
LOG_HTTP=true
LOG_HTTP_BODIES=false
